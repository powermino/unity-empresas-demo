# Copie para .env.local e ajuste. Variáveis VITE_* ficam públicas no build.

# Número de WhatsApp comercial (somente dígitos, com DDI 55).
# Valor padrão no código: 554135016022, publicado no site oficial (unityempresas.com.br).
# CONFIRMAR com a Unity antes de publicar.
VITE_WHATSAPP_NUMBER=

# Endpoint do formulário (ex.: Formspree, Getform, Basin, função serverless).
# Vazio => o formulário envia a mensagem pelo WhatsApp em vez de um POST.
VITE_FORM_ENDPOINT=

# URL pública do site (para canonical/Open Graph). Ex.: https://unity-conceito.netlify.app
VITE_SITE_URL=

# Indexação: deixe "noindex, nofollow" enquanto for demonstração,
# para não competir com o site oficial nos buscadores.
VITE_ROBOTS=noindex, nofollow

# Subpasta de publicação (GitHub Pages: /nome-do-repo/). Padrão: /
VITE_BASE=/
